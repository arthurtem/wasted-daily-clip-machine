# Copy to .env.local for local development, or set these in Vercel.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Password for the single review dashboard user.
DASHBOARD_PASSWORD=change-me

# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me"

# Fine-grained GitHub token with Actions: read and write on this repo.
GITHUB_TOKEN=github_pat_change_me
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-repo-name

# "manual" hides the upload button; "api" shows it.
UPLOAD_MODE=manual

# Added by the Vercel Blob storage integration; used to delete the video and
# thumbnail after a Short is marked as posted.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_change_me
