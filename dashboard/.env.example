# Copy to .env.local for local development, or set these in Vercel.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Password for the single review dashboard user.
DASHBOARD_PASSWORD=change-me

# Optional read-only password for app reviewers (e.g. Google). Remove after review.
REVIEWER_PASSWORD=change-me-too

# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me"

# Fine-grained GitHub token with Actions: read and write on this repo.
GITHUB_TOKEN=github_pat_change_me
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-repo-name

# Twitch search (dashboard fetch panel)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# YouTube OAuth (Connect YouTube in Settings)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key
# No trailing slash; must match the Google OAuth redirect URI.
APP_URL=https://example.com

# "manual" hides the upload button; "api" shows it.
UPLOAD_MODE=manual

# Upload pacing shown in the dashboard header.
UPLOAD_MAX_PER_DAY=25
UPLOAD_WINDOW_START=13:00
UPLOAD_WINDOW_END=05:00
UPLOAD_TIMEZONE=Europe/Brussels
UPLOAD_MIN_GAP_MINUTES=30
UPLOAD_SLOT_MINUTES=15

# Fetch panel defaults (must match config/settings.yaml).
DEFAULT_GAME_NAME=Grand Theft Auto VI
DEFAULT_MIN_VIEWS=150

# Added by the Vercel Blob storage integration; used to delete the video and
# thumbnail after a Short is marked as posted.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_change_me

# Public legal pages and upload compliance
OWNER_NAME=Your Name
CONTACT_EMAIL=you@example.com
CHANNEL_NAME=Wasted Daily
