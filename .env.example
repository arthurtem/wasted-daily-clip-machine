# Postgres connection string (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Twitch API application credentials
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# YouTube OAuth (dashboard Connect flow / worker upload)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key
APP_URL=https://example.com
CHANNEL_NAME=Wasted Daily
YT_PRIVACY_STATUS=private

# Optional override for game_name in config/settings.yaml
GAME_NAME="Grand Theft Auto VI"

# Whisper model cache
WHISPER_CACHE_DIR=.cache/whisper

# ffmpeg binaries (use ffmpeg-alt/ffprobe-alt locally if the default build lacks libass)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Reddit discovery (ranking signal only; resolves Twitch clip links)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=wasted-daily-clip-machine/0.1

# Optional override for min_views in config/settings.yaml
MIN_VIEWS=150
